# Copy to .env and adjust. Only DATABASE_URL is required.
APP_ENV=development
PORT=8080
# Create this user and database in pgAdmin (or with createuser/createdb) first.
DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/dashboard?sslmode=disable
# Integration tests: a superuser URL; each test creates and drops its own database.
# TEST_POSTGRES_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_QUERY_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
# Business timezone (GMT+7). Date presets like "This Month" are computed in this zone.
BUSINESS_TZ=Asia/Ho_Chi_Minh
# Comma-separated browser origins allowed to call the API, exactly as the browser sends them:
# scheme://host[:port], no wildcard, path or trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted for the client IP.
# Empty trusts no proxy: the client IP is the TCP peer address.
# TRUSTED_PROXIES=10.0.0.0/8
