{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && go build -o bin/fmthook.exe ./cmd/fmthook && bin/fmthook.exe",
            "timeout": 120,
            "statusMessage": "Formatting and linting"
          }
        ]
      }
    ]
  }
}
